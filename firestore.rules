rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // plan / freeImageUsed are server-owned (Admin SDK bypasses rules).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.plan == 'free'
        && request.resource.data.freeImageUsed == false;
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['plan', 'freeImageUsed']);
    }

    match /products/{productId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    match /campaigns/{campaignId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      match /{document=**} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.userId
            == request.auth.uid;
      }
    }

    match /usage/{docId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}

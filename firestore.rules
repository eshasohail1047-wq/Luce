rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Platform owner email — may hold Pro without checkout.
    function isPlatformOwner() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'eshasohail1047@gmail.com';
    }

    function currentPlan() {
      return resource.data.keys().hasAny(['plan'])
        ? resource.data.plan
        : 'free';
    }

    function nextPlan() {
      return request.resource.data.keys().hasAny(['plan'])
        ? request.resource.data.plan
        : 'free';
    }

    function currentFreeUsed() {
      return resource.data.keys().hasAny(['freeImageUsed'])
        ? resource.data.freeImageUsed == true
        : false;
    }

    function nextFreeUsed() {
      return request.resource.data.keys().hasAny(['freeImageUsed'])
        ? request.resource.data.freeImageUsed == true
        : false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      // New accounts must start on free — clients cannot create a paid plan doc.
      // Owner may create with Pro.
      allow create: if isOwner(userId) && (
        nextPlan() == 'free'
        || (isPlatformOwner() && nextPlan() == 'pro')
      );
      // Clients cannot change plan. freeImageUsed may only stay false or become true.
      // Owner may set / keep Pro.
      allow update: if isOwner(userId)
        && (
          (
            nextPlan() == currentPlan()
            && (nextFreeUsed() == currentFreeUsed() || nextFreeUsed() == true)
          )
          || (isPlatformOwner() && nextPlan() == 'pro')
        );
    }

    match /products/{productId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /campaigns/{campaignId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      match /{document=**} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.userId
            == request.auth.uid;
      }
    }

    match /usage/{docId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
